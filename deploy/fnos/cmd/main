#!/bin/bash
#
# 专注盒子 FocusBox - 飞牛 fnOS 生命周期脚本
#
# 本应用不使用 fnOS 的 docker-project 资源，而是由本脚本管理容器。
# fpk 自带服务端源码与 Dockerfile，安装后优先在 NAS 本地构建 API-only 镜像；
# 也支持预置离线镜像 tar，找不到时才回退到 GHCR 拉取。
# 前端界面不随 fpk 分发（内置在安卓 APK 中），服务端只提供 /api/*。
# 脚本以 root 运行（需要访问 Docker）。
#
# 退出码：0 = 成功/运行中，1 = 失败，3 = 未运行（仅 status）。

set +e

# fnOS 调用生命周期脚本时 PATH 几乎为空，显式补齐才能找到 docker 等命令。
export PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin${PATH:+:$PATH}"

CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTAINER="${FOCUSBOX_CONTAINER:-focusbox}"
APP_VERSION="${TRIM_APPVER:-1.1.1}"
# build.sh 会把 DEFAULT_IMAGE_TAG 改成实际版本；FOCUSBOX_IMAGE_TAG 可覆盖。
DEFAULT_IMAGE_TAG="1.1.1"
IMAGE_REPO="${FOCUSBOX_IMAGE_REPO:-focusbox-api}"
IMAGE_TAG="${FOCUSBOX_IMAGE_TAG:-$DEFAULT_IMAGE_TAG}"
IMAGE="${FOCUSBOX_IMAGE:-${IMAGE_REPO}:${IMAGE_TAG}}"
GHCR_IMAGE="${FOCUSBOX_GHCR_IMAGE:-ghcr.io/nickkk333/focusbox:${IMAGE_TAG}}"
# 随 fpk 分发的镜像构建上下文（server/ + package*.json + Dockerfile）
CONTEXT_DIR="$CMD_DIR/../app/context"
PKGVAR="${TRIM_PKGVAR:-/tmp}"
LOG="${TRIM_TEMP_LOGFILE:-${PKGVAR}/focusbox.log}"
MAIN_LOG="${PKGVAR}/focusbox-main.log"

# 安装向导字段（fnOS 会把向导值作为环境变量传入生命周期脚本）
PORT="${wizard_port:-${TRIM_SERVICE_PORT:-8082}}"
APP_USERNAME="${wizard_username:-}"
APP_PASSWORD="${wizard_password:-}"

# 数据目录固定映射到飞牛共享目录，安装时无需选择。
DATA_HOST_DIR="${FOCUSBOX_DATA_DIR:-/vol1/@appshare/focusbox}"
DATA_UID="${TRIM_UID:-1000}"
DATA_GID="${TRIM_GID:-1000}"

mkdir -p "$PKGVAR" 2>/dev/null || true

log() {
  echo "[focusbox main] $*" >> "$MAIN_LOG" 2>&1
}

fail() {
  log "ERROR: $*"
  echo "[focusbox] $*" > "$LOG"
  exit 1
}

normalize_port() {
  case "$PORT" in
    ''|*[!0-9]*) PORT=8082 ;;
  esac
  if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    PORT=8082
  fi
}

ensure_image() {
  local rc attempt
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  # 1) 用户预先放置的离线镜像 tar（完全无外网也能安装）。
  #    同时兼容 CI Release 里导出的 focusbox-<版本>-<架构>.tar（完整 Web 镜像，
  #    运行时由 FOCUSBOX_API_ONLY=1 切换为纯数据服务）。
  mkdir -p "$DATA_HOST_DIR" 2>/dev/null || true
  local image_tar="${DATA_HOST_DIR}/focusbox-api-${IMAGE_TAG}.tar"
  local candidate source
  for candidate in \
      "$image_tar" \
      "${DATA_HOST_DIR}/focusbox-${IMAGE_TAG}-amd64.tar" \
      "${DATA_HOST_DIR}/focusbox-${IMAGE_TAG}-arm64.tar" \
      "${DATA_HOST_DIR}/focusbox-${IMAGE_TAG}.tar"; do
    [ -f "$candidate" ] || continue
    log "loading offline image tar: $candidate"
    docker load -i "$candidate" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker load exit=${rc}"
    [ "$rc" -eq 0 ] || continue

    # CI 导出的 tar 内镜像名是 focusbox:<版本>，重命名为容器启动使用的名字
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
      for source in "focusbox:${IMAGE_TAG}" "ghcr.io/nickkk333/focusbox:${IMAGE_TAG}" "focusbox:latest"; do
        if docker image inspect "$source" >/dev/null 2>&1; then
          docker tag "$source" "$IMAGE" >> "$MAIN_LOG" 2>&1 || true
          break
        fi
      done
    fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
      return 0
    fi
  done

  # 2) 用 fpk 自带的服务端源码在 NAS 本地构建（只需拉取 node:24-alpine 基础镜像）
  if [ -f "$CONTEXT_DIR/Dockerfile" ]; then
    log "building image from bundled context: $CONTEXT_DIR"
    docker build -t "$IMAGE" "$CONTEXT_DIR" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker build exit=${rc}"
    if [ "$rc" -eq 0 ] && docker image inspect "$IMAGE" >/dev/null 2>&1; then
      return 0
    fi
  fi

  # 3) 兜底：从 GHCR 拉取已发布的镜像
  log "pulling fallback image: $GHCR_IMAGE"
  attempt=1
  while [ "$attempt" -le 3 ]; do
    docker pull "$GHCR_IMAGE" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker pull attempt=${attempt} exit=${rc}"
    if [ "$rc" -eq 0 ]; then
      docker tag "$GHCR_IMAGE" "$IMAGE" >> "$MAIN_LOG" 2>&1
      if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        return 0
      fi
    fi
    attempt=$((attempt + 1))
    sleep 5
  done

  fail "服务端镜像准备失败：${IMAGE}。请查看 ${MAIN_LOG}；也可以把离线镜像放到 ${image_tar} 后重试。"
}

prepare_data_dir() {
  if [ -z "${FOCUSBOX_DATA_DIR:-}" ] && [ ! -d /vol1 ]; then
    fail "未找到存储卷 /vol1，无法创建数据目录 ${DATA_HOST_DIR}。"
  fi
  mkdir -p "$DATA_HOST_DIR" 2>/dev/null
  if [ ! -d "$DATA_HOST_DIR" ]; then
    fail "无法创建数据目录 ${DATA_HOST_DIR}。"
  fi

  # 只在目录属主不正确时递归修正一次，避免每次启动都遍历数据。
  # 飞牛共享目录使用 ACL，chown 失败时退化为放宽权限；容器入口还会再修正一次。
  local owner
  owner="$(stat -c '%u' "$DATA_HOST_DIR" 2>/dev/null)"
  if [ "$owner" != "$DATA_UID" ]; then
    chown -R "$DATA_UID:$DATA_GID" "$DATA_HOST_DIR" 2>/dev/null \
      || chmod -R a+rwX "$DATA_HOST_DIR" 2>/dev/null \
      || true
  fi
}

is_running() {
  docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true
}

normalize_port

case "$1" in
  pull)
    log "=== pull === version=${APP_VERSION} image=${IMAGE}"
    command -v docker >/dev/null 2>&1 || fail "未找到 docker 命令，请确认飞牛 Docker 服务已启用。"
    ensure_image || exit 1
    exit 0
    ;;

  start)
    log "=== start === version=${APP_VERSION} port=${PORT} data=${DATA_HOST_DIR} image=${IMAGE}"

    if is_running; then
      current_image="$(docker inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null)"
      if [ "$current_image" = "$IMAGE" ]; then
        log "container already running with ${IMAGE}"
        exit 0
      fi
      log "recreating container: ${current_image:-unknown} -> ${IMAGE}"
      docker stop "$CONTAINER" >> "$MAIN_LOG" 2>&1
      docker rm "$CONTAINER" >> "$MAIN_LOG" 2>&1
    fi

    command -v docker >/dev/null 2>&1 || fail "未找到 docker 命令，请确认飞牛 Docker 服务已启用。"

    ensure_image || exit 1
    prepare_data_dir || exit 1

    # 清理上次异常退出留下的同名容器。
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

    # 通过环境变量传递，避免密码中的 $、反引号等被 shell 再次展开。
    export FOCUSBOX_USERNAME="$APP_USERNAME"
    export FOCUSBOX_PASSWORD="$APP_PASSWORD"

    log "docker run ${IMAGE} -> host port ${PORT}"
    # 不指定 --user：镜像入口会以 root 修正 /data 属主，再降权到 node 运行。
    docker run -d \
      --name "$CONTAINER" \
      --restart unless-stopped \
      -p "${PORT}:8082" \
      -e PORT=8082 \
      -e HOST=0.0.0.0 \
      -e DATA_DIR=/data \
      -e TZ=Asia/Shanghai \
      -e FOCUSBOX_API_ONLY=1 \
      -e FOCUSBOX_USERNAME \
      -e FOCUSBOX_PASSWORD \
      -e "FOCUSBOX_FRAME_ANCESTORS='self' http: https:" \
      -v "${DATA_HOST_DIR}:/data" \
      "$IMAGE" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker run exit=$rc"

    sleep 2
    if is_running; then
      log "started ok"
      exit 0
    fi
    fail "容器启动失败，请查看 ${MAIN_LOG}。"
    ;;

  stop)
    log "=== stop ==="
    docker stop "$CONTAINER" >> "$MAIN_LOG" 2>&1
    docker rm "$CONTAINER" >> "$MAIN_LOG" 2>&1
    log "stopped"
    exit 0
    ;;

  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;

  *)
    echo "Unknown command: $1" > "$LOG"
    exit 1
    ;;
esac
