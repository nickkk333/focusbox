#!/bin/bash
#
# 专注盒子 FocusBox - 飞牛 fnOS 生命周期脚本
#
# 本应用不使用 fnOS 的 docker-project 资源，而是由本脚本管理容器。
# fpk 只是轻量外壳：安装时从 GHCR 拉取多架构镜像，启动时直接使用本地镜像。
# 脚本以 root 运行（需要访问 Docker）。
#
# 退出码：0 = 成功/运行中，1 = 失败，3 = 未运行（仅 status）。

set +e

CONTAINER="${FOCUSBOX_CONTAINER:-focusbox}"
APP_VERSION="${TRIM_APPVER:-1.0.3}"
# build.sh 会把 DEFAULT_IMAGE_TAG 改成实际版本；FOCUSBOX_IMAGE_TAG 可覆盖。
DEFAULT_IMAGE_TAG="1.0.3"
IMAGE_REPO="${FOCUSBOX_IMAGE_REPO:-ghcr.io/nickkk333/focusbox}"
IMAGE_TAG="${FOCUSBOX_IMAGE_TAG:-$DEFAULT_IMAGE_TAG}"
IMAGE="${FOCUSBOX_IMAGE:-${IMAGE_REPO}:${IMAGE_TAG}}"
PKGVAR="${TRIM_PKGVAR:-/tmp}"
LOG="${TRIM_TEMP_LOGFILE:-${PKGVAR}/focusbox.log}"
MAIN_LOG="${PKGVAR}/focusbox-main.log"

# 安装向导字段（fnOS 会把向导值作为环境变量传入生命周期脚本）
PORT="${wizard_port:-${TRIM_SERVICE_PORT:-8083}}"
APP_USERNAME="${wizard_username:-}"
APP_PASSWORD="${wizard_password:-}"

# 数据目录固定映射到飞牛共享目录，安装时无需选择。
DATA_HOST_DIR="${FOCUSBOX_DATA_DIR:-/vol1/@appshare/focusbox}"
DATA_UID="${TRIM_UID:-1000}"
DATA_GID="${TRIM_GID:-1000}"

mkdir -p "$PKGVAR" 2>/dev/null || true

log() {
  echo "[focusbox main] $*" >> "$MAIN_LOG" 2>&1
}

fail() {
  log "ERROR: $*"
  echo "[focusbox] $*" > "$LOG"
  exit 1
}

normalize_port() {
  case "$PORT" in
    ''|*[!0-9]*) PORT=8083 ;;
  esac
  if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    PORT=8083
  fi
}

ensure_image() {
  local rc attempt
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  log "pulling image: $IMAGE"
  attempt=1
  while [ "$attempt" -le 3 ]; do
    docker pull "$IMAGE" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker pull attempt=${attempt} exit=${rc}"
    if [ "$rc" -eq 0 ] && docker image inspect "$IMAGE" >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 5
  done

  fail "镜像下载失败：${IMAGE}。请确认 NAS 可以访问 ghcr.io、GHCR 包可见性为 Public，或先在 Docker 中手动拉取。"
}

prepare_data_dir() {
  if [ -z "${FOCUSBOX_DATA_DIR:-}" ] && [ ! -d /vol1 ]; then
    fail "未找到存储卷 /vol1，无法创建数据目录 ${DATA_HOST_DIR}。"
  fi
  mkdir -p "$DATA_HOST_DIR" 2>/dev/null
  if [ ! -d "$DATA_HOST_DIR" ]; then
    fail "无法创建数据目录 ${DATA_HOST_DIR}。"
  fi

  # 只在目录属主不正确时递归修正一次，避免每次启动都遍历数据。
  # 飞牛共享目录使用 ACL，chown 失败时退化为放宽权限；容器入口还会再修正一次。
  local owner
  owner="$(stat -c '%u' "$DATA_HOST_DIR" 2>/dev/null)"
  if [ "$owner" != "$DATA_UID" ]; then
    chown -R "$DATA_UID:$DATA_GID" "$DATA_HOST_DIR" 2>/dev/null \
      || chmod -R a+rwX "$DATA_HOST_DIR" 2>/dev/null \
      || true
  fi
}

is_running() {
  docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true
}

normalize_port

case "$1" in
  pull)
    log "=== pull === version=${APP_VERSION} image=${IMAGE}"
    command -v docker >/dev/null 2>&1 || fail "未找到 docker 命令，请确认飞牛 Docker 服务已启用。"
    ensure_image || exit 1
    exit 0
    ;;

  start)
    log "=== start === version=${APP_VERSION} port=${PORT} data=${DATA_HOST_DIR} image=${IMAGE}"

    if is_running; then
      current_image="$(docker inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null)"
      if [ "$current_image" = "$IMAGE" ]; then
        log "container already running with ${IMAGE}"
        exit 0
      fi
      log "recreating container: ${current_image:-unknown} -> ${IMAGE}"
      docker stop "$CONTAINER" >> "$MAIN_LOG" 2>&1
      docker rm "$CONTAINER" >> "$MAIN_LOG" 2>&1
    fi

    command -v docker >/dev/null 2>&1 || fail "未找到 docker 命令，请确认飞牛 Docker 服务已启用。"

    ensure_image || exit 1
    prepare_data_dir || exit 1

    # 清理上次异常退出留下的同名容器。
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

    # 通过环境变量传递，避免密码中的 $、反引号等被 shell 再次展开。
    export FOCUSBOX_USERNAME="$APP_USERNAME"
    export FOCUSBOX_PASSWORD="$APP_PASSWORD"

    log "docker run ${IMAGE} -> host port ${PORT}"
    # 不指定 --user：镜像入口会以 root 修正 /data 属主，再降权到 node 运行。
    docker run -d \
      --name "$CONTAINER" \
      --restart unless-stopped \
      -p "${PORT}:3000" \
      -e PORT=3000 \
      -e HOST=0.0.0.0 \
      -e DATA_DIR=/data \
      -e TZ=Asia/Shanghai \
      -e FOCUSBOX_USERNAME \
      -e FOCUSBOX_PASSWORD \
      -e "FOCUSBOX_FRAME_ANCESTORS='self' http: https:" \
      -v "${DATA_HOST_DIR}:/data" \
      "$IMAGE" >> "$MAIN_LOG" 2>&1
    rc=$?
    log "docker run exit=$rc"

    sleep 2
    if is_running; then
      log "started ok"
      exit 0
    fi
    fail "容器启动失败，请查看 ${MAIN_LOG}。"
    ;;

  stop)
    log "=== stop ==="
    docker stop "$CONTAINER" >> "$MAIN_LOG" 2>&1
    docker rm "$CONTAINER" >> "$MAIN_LOG" 2>&1
    log "stopped"
    exit 0
    ;;

  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;

  *)
    echo "Unknown command: $1" > "$LOG"
    exit 1
    ;;
esac
