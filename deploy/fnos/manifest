# 专注盒子 FocusBox - 飞牛 fnOS 应用包描述
# 版本号由 deploy/fnos/build.sh 在打包时写入，必须为 X.Y.Z。
appname=focusbox
version=1.1.0
display_name=专注盒子
desc=FocusBox 安卓客户端的数据服务端，只提供任务、备忘、专注记录等 API；应用界面随安卓 APK 分发。
source=thirdparty
platform=all
maintainer=FocusBox
maintainer_url=https://github.com/nickkk333/focusbox
distributor=FocusBox
distributor_url=https://github.com/nickkk333/focusbox
os_min_version=1.2.0
desktop_uidir=ui
desktop_applaunchname=focusbox.main
service_port=8083
checkport=false
ctl_stop=true
disable_authorization_path=true
changelog=改为纯数据服务：不再提供网页前端，支持安卓客户端跨域访问；服务端镜像可随包在 NAS 本地构建，数据仍保存在本地 SQLite。
